# BARRY environment variables
#
# None of these are required to run the test suite or the simulator
# locally — with nothing set, BARRY uses the deterministic MockReasoner
# and an in-memory backend, which is exactly what CI and `npm test` run
# on. Set the vars below to move to real persistence and real LLM
# reasoning without any code changes.

# --- Reasoner (Phase 1.5) ---------------------------------------------

# OpenAI API key. Required for the LLM-backed reasoner. Server-only —
# never exposed to the browser.
OPENAI_API_KEY=

# Reasoner selection. Leave unset (or anything other than "openai") to
# keep using MockReasoner. Set to "openai" AND set OPENAI_API_KEY to use
# the LLM-backed reasoner instead.
BARRY_REASONER=mock

# Which OpenAI model the LLM reasoner calls. Defaults to gpt-4o-mini if unset.
BARRY_MODEL=gpt-4o-mini

# --- Persistence (Phase 1.5) ------------------------------------------

# Supabase project connection. Server-only — set BOTH to move
# ConversationStore/BarryBackend from in-memory to Supabase-backed.
# Leaving either unset keeps the in-memory implementation.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
